{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autarqia.network/schemas/autarqia-mppi-v0.schema.json",
  "title": "Autarqia MPP-I Profile v0.1.0 Wire Schema",
  "type": "object",
  "$defs": {
    "AtomicAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,38})$",
      "description": "Canonical base-10 integer string representing atomic token units (u128)."
    },
    "Hex32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "HexAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "HexBytes": {
      "type": "string",
      "pattern": "^0x([0-9a-fA-F]{2})+$"
    },
    "RationalRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator_atomic", "denominator_units"],
      "properties": {
        "numerator_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "denominator_units": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "InferenceQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "schema_version",
        "quote_id",
        "run_id",
        "provider_id",
        "node_id",
        "request_commitment",
        "model_id",
        "model_revision",
        "tokenizer_hash",
        "chat_template_hash",
        "payment_rail",
        "chain_id",
        "verifying_contract",
        "token_address",
        "payee_address",
        "operator_address",
        "input_tokens_quoted",
        "max_output_tokens",
        "input_rate",
        "output_rate",
        "quoted_prefill_atomic",
        "max_total_atomic",
        "issued_at_wall_ms",
        "expires_at_wall_ms",
        "max_clock_skew_ms",
        "provider_signature"
      ],
      "properties": {
        "profile": { "const": "urn:autarqia:mppi:acknowledged-usage:0" },
        "schema_version": { "const": "0.1.0" },
        "quote_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "provider_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "request_commitment": { "$ref": "#/$defs/Hex32" },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "model_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tokenizer_hash": { "$ref": "#/$defs/Hex32" },
        "chat_template_hash": { "$ref": "#/$defs/Hex32" },
        "payment_rail": { "enum": ["ando_mppi_arc_v1", "circle_gateway_x402"] },
        "chain_id": { "type": "integer", "minimum": 1 },
        "verifying_contract": { "$ref": "#/$defs/HexAddress" },
        "token_address": { "$ref": "#/$defs/HexAddress" },
        "payee_address": { "$ref": "#/$defs/HexAddress" },
        "operator_address": { "$ref": "#/$defs/HexAddress" },
        "input_tokens_quoted": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "input_rate": { "$ref": "#/$defs/RationalRate" },
        "output_rate": { "$ref": "#/$defs/RationalRate" },
        "quoted_prefill_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "max_total_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "issued_at_wall_ms": { "type": "integer", "minimum": 0 },
        "expires_at_wall_ms": { "type": "integer", "minimum": 0 },
        "max_clock_skew_ms": { "type": "integer", "minimum": 0 },
        "provider_signature": { "$ref": "#/$defs/HexBytes" }
      }
    },
    "InferencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "quote_id",
        "run_id",
        "request_commitment",
        "channel_id",
        "payer_address",
        "signer_address",
        "payee_address",
        "token_address",
        "chain_id",
        "verifying_contract",
        "max_total_atomic",
        "max_input_tokens",
        "max_output_tokens",
        "input_rate",
        "output_rate",
        "baseline_settled_or_high_water_atomic",
        "expires_at_wall_ms",
        "buyer_signature"
      ],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quote_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "request_commitment": { "$ref": "#/$defs/Hex32" },
        "channel_id": { "$ref": "#/$defs/Hex32" },
        "payer_address": { "$ref": "#/$defs/HexAddress" },
        "signer_address": { "$ref": "#/$defs/HexAddress" },
        "payee_address": { "$ref": "#/$defs/HexAddress" },
        "token_address": { "$ref": "#/$defs/HexAddress" },
        "chain_id": { "type": "integer", "minimum": 1 },
        "verifying_contract": { "$ref": "#/$defs/HexAddress" },
        "max_total_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "max_input_tokens": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "input_rate": { "$ref": "#/$defs/RationalRate" },
        "output_rate": { "$ref": "#/$defs/RationalRate" },
        "baseline_settled_or_high_water_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "expires_at_wall_ms": { "type": "integer", "minimum": 0 },
        "buyer_signature": { "$ref": "#/$defs/HexBytes" }
      }
    },
    "CreditGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "policy_id",
        "quote_id",
        "grant_seq",
        "cumulative_authorized_atomic",
        "max_authorized_output_tokens",
        "causal_ack_seq",
        "causal_meter_seq",
        "expires_at_wall_ms",
        "buyer_signature"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policy_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "quote_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "grant_seq": { "type": "integer", "minimum": 1 },
        "cumulative_authorized_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "max_authorized_output_tokens": { "type": "integer", "minimum": 1 },
        "causal_ack_seq": { "type": "integer", "minimum": 0 },
        "causal_meter_seq": { "type": "integer", "minimum": 0 },
        "expires_at_wall_ms": { "type": "integer", "minimum": 0 },
        "buyer_signature": { "$ref": "#/$defs/HexBytes" }
      }
    },
    "MeterFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "meter_seq",
        "output_seq",
        "prefill_completed",
        "input_tokens_processed",
        "output_tokens_generated",
        "prefix_commitment",
        "provisional_delivered_amount_atomic",
        "cumulative_amount_due_atomic",
        "last_acknowledged_seq",
        "last_acknowledged_output_seq",
        "provider_signature"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "meter_seq": { "type": "integer", "minimum": 1 },
        "output_seq": { "type": "integer", "minimum": 0 },
        "prefill_completed": { "type": "boolean" },
        "input_tokens_processed": { "type": "integer", "minimum": 0 },
        "output_tokens_generated": { "type": "integer", "minimum": 0 },
        "prefix_commitment": { "$ref": "#/$defs/Hex32" },
        "provisional_delivered_amount_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "cumulative_amount_due_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "last_acknowledged_seq": { "type": "integer", "minimum": 0 },
        "last_acknowledged_output_seq": { "type": "integer", "minimum": 0 },
        "provider_signature": { "$ref": "#/$defs/HexBytes" }
      }
    },
    "DeliveryAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "ack_seq",
        "acknowledged_output_seq",
        "acknowledged_input_tokens",
        "prefix_commitment",
        "acknowledged_cumulative_due_atomic",
        "channel_cumulative_voucher_atomic",
        "ack_signature",
        "voucher_signature"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ack_seq": { "type": "integer", "minimum": 1 },
        "acknowledged_output_seq": { "type": "integer", "minimum": 0 },
        "acknowledged_input_tokens": { "type": "integer", "minimum": 0 },
        "prefix_commitment": { "$ref": "#/$defs/Hex32" },
        "acknowledged_cumulative_due_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "channel_cumulative_voucher_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "ack_signature": { "$ref": "#/$defs/HexBytes" },
        "voucher_signature": { "$ref": "#/$defs/HexBytes" }
      }
    },
    "FinalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "quote_id",
        "policy_id",
        "channel_id",
        "payment_rail",
        "receipt_version",
        "terminal_status",
        "input_tokens_processed",
        "output_tokens_generated",
        "output_tokens_acknowledged",
        "final_prefix_commitment",
        "acknowledged_prefix_commitment",
        "authorized_atomic",
        "funded_available_atomic",
        "acknowledged_due_atomic",
        "voucher_collectible_atomic",
        "settled_atomic",
        "uncollectible_exposure_atomic",
        "reconciliation_state",
        "provider_signature"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "quote_id": { "type": "string" },
        "policy_id": { "type": "string" },
        "channel_id": { "$ref": "#/$defs/Hex32" },
        "payment_rail": { "enum": ["ando_mppi_arc_v1", "circle_gateway_x402"] },
        "receipt_version": { "type": "integer", "minimum": 1 },
        "terminal_status": {
          "enum": [
            "completed",
            "cancelled_by_buyer",
            "halted_exposure_limit",
            "halted_credit_exhausted",
            "halted_energy_limit",
            "halted_worker_error"
          ]
        },
        "input_tokens_processed": { "type": "integer", "minimum": 0 },
        "output_tokens_generated": { "type": "integer", "minimum": 0 },
        "output_tokens_acknowledged": { "type": "integer", "minimum": 0 },
        "final_prefix_commitment": { "$ref": "#/$defs/Hex32" },
        "acknowledged_prefix_commitment": { "$ref": "#/$defs/Hex32" },
        "authorized_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "funded_available_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "acknowledged_due_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "voucher_collectible_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "settled_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "uncollectible_exposure_atomic": { "$ref": "#/$defs/AtomicAmount" },
        "reconciliation_state": {
          "enum": [
            "pending_voucher",
            "voucher_collectible",
            "settlement_submitted",
            "settled",
            "uncollectible_recorded"
          ]
        },
        "provider_signature": { "$ref": "#/$defs/HexBytes" }
      }
    }
  }
}
